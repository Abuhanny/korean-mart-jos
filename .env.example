# --- Supabase ---
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER expose this to the browser. Server-only. Used in scripts/create-admin.ts
# and any server action that must bypass RLS (e.g. admin image cleanup).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of the deployed site (used for metadata / OG tags / sitemap /
# Paystack callback URLs — must be correct in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback WhatsApp number used only if no row exists yet in business_settings.
# Format: international, digits only, no + or spaces, e.g. 2348012345678
NEXT_PUBLIC_WHATSAPP_FALLBACK=2348012345678

# --- Paystack ---
# From the Paystack Dashboard: Settings > API Keys & Webhooks.
# Use a test secret key (starts with sk_test_) during development, and a
# live key (sk_live_) only once you're ready to accept real payments.
# Server-only — never exposed to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
